generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String   @id @default(cuid())
  title            String
  subtitle         String?
  localName        String?
  tagline          String?
  slug             String   @unique
  shortDescription String
  description      String
  problem          String
  solution         String
  architecture     String
  designQuestion   String
  learned          String
  contribution     String?
  kind             String
  status           String
  technologies     String[]
  features         String[]
  githubUrl        String
  liveUrl          String?
  imageUrl         String?
  galleryUrls      String[] @default([])
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  level     String   @default("Practicing")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, category])
}

model Experience {
  id           String   @id @default(cuid())
  title        String
  organization String
  description  String
  learned      String
  related      String
  category     String
  period       String
  year         String?
  startDate    DateTime?
  endDate      DateTime?
  location     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Education {
  id          String   @id @default(cuid())
  institution String
  degree      String
  field       String
  startDate   DateTime?
  endDate     DateTime?
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  date        DateTime?
  url         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  readAt    DateTime?
}
